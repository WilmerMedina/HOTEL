<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Consola: útil en desarrollo y para leer logs en contenedores (docker logs, kubectl logs) -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Archivo con rotación diaria + límite de tamaño, para no llenar el disco -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/hotel-app.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>logs/hotel-app-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Nivel específico para tu paquete de seguridad: más detalle que el resto de la app -->
    <logger name="com.example.hotel.security" level="DEBUG" />
    <logger name="com.example.hotel.exception" level="DEBUG" />

    <!-- Baja el ruido de Spring Security en producción (evita loguear cada request) -->
    <logger name="org.springframework.security" level="WARN" />

    <root level="INFO">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
    </root>

</configuration>